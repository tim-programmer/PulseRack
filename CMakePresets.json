{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with the default compiler",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized build with the default compiler (the optimizer finds warnings a debug build does not)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "release-clang",
      "displayName": "Release (clang)",
      "inherits": ["clang", "release"]
    },
    {
      "name": "release-msvc",
      "displayName": "Release (MSVC)",
      "description": "Optimized build with MSVC and Ninja: run it from a Developer PowerShell / x64 Native Tools prompt",
      "inherits": "release",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "release-clang", "configurePreset": "release-clang" },
    { "name": "release-msvc", "configurePreset": "release-msvc" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4, "timeout": 900, "noTestsAction": "error" }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "release-clang", "inherits": "base", "configurePreset": "release-clang" },
    { "name": "release-msvc", "inherits": "base", "configurePreset": "release-msvc" }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    },
    {
      "name": "release-clang",
      "steps": [
        { "type": "configure", "name": "release-clang" },
        { "type": "build", "name": "release-clang" },
        { "type": "test", "name": "release-clang" }
      ]
    },
    {
      "name": "release-msvc",
      "steps": [
        { "type": "configure", "name": "release-msvc" },
        { "type": "build", "name": "release-msvc" },
        { "type": "test", "name": "release-msvc" }
      ]
    }
  ]
}
